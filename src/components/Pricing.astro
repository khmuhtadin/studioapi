---
const tiers = [
  {
    name: 'Developer',
    blurb: 'For prototypes, side projects, and first agents.',
    features: ['1,000 calls / month', 'Every connected source', 'Community support', 'Rate limit 10 req/s'],
    highlight: false,
  },
  {
    name: 'Scale',
    blurb: 'For products and teams shipping to real users.',
    features: ['1,000,000 calls / month', '99.9% uptime SLA', 'SSO / SAML', 'Priority support', 'Per-key budgets & alerts'],
    highlight: true,
  },
  {
    name: 'Enterprise',
    blurb: 'For platforms that resell data at scale.',
    features: ['99.99% SLA', 'Dedicated infrastructure', 'Data residency & DPA', 'Volume pricing', 'Onboarding engineer'],
    highlight: false,
  },
];
---

<section id="pricing" class="section">
  <div class="container-wide py-20 lg:py-28">
    <div class="max-w-2xl">
      <p class="kicker reveal"><span class="idx">06</span> — pricing</p>
      <h2 class="display-2 mt-5 reveal reveal-1">
        Pricing plans are being <span class="accent-text">finalised</span>
      </h2>
      <p class="mt-5 text-base leading-relaxed text-muted reveal reveal-2">
        We're crafting fair, transparent tiers that scale from individual
        developers to enterprise platforms. Prices will be published soon.
      </p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {tiers.map((t, i) => (
        <div class={`tile flex flex-col p-7 ${t.highlight ? 'border-accent/60 bg-accent/5' : ''} reveal reveal-${i + 2}`}>
          <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] muted">{t.name}</span>
          <div class="mt-4">
            <span class="display text-3xl sm:text-4xl text-muted">Coming soon</span>
          </div>
          <p class="mt-3 text-sm text-muted">{t.blurb}</p>
          <ul class="mt-6 flex flex-col gap-2.5">
            {t.features.map((f) => (
              <li class="flex items-start gap-2.5 text-sm">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <span class={`btn mt-8 w-full text-center ${t.highlight ? 'btn-primary' : 'btn-ghost'} opacity-60 cursor-not-allowed`}>Coming soon</span>
        </div>
      ))}
    </div>
  </div>
</section>
