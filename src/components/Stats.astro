---
const stats = [
  { value: '30+', label: 'connected sources', note: 'and growing monthly' },
  { value: '<40ms', label: 'p95 response', note: 'cached, edge-served' },
  { value: '99.99%', label: 'uptime target', note: 'multi-source failover' },
  { value: '1', label: 'key to rule them all', note: 'scoped per team & agent' },
];
---

<section class="section">
  <div class="container-wide grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 xl:grid-cols-4">
    {stats.map((s, i) => (
      <div class={`flex min-w-0 flex-col bg-panel p-7 sm:p-8 ${i === 0 ? 'reveal' : `reveal reveal-${i + 1}`}`}>
        <p class="whitespace-nowrap text-3xl font-semibold tracking-tight text-accent sm:text-4xl" style="font-variant-numeric: tabular-nums">{s.value}</p>
        <p class="mt-3 break-words font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-ink">{s.label}</p>
        <p class="mt-1 break-words text-sm leading-snug text-muted">{s.note}</p>
      </div>
    ))}
  </div>
</section>
