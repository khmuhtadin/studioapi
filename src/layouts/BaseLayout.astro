---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'StudioAPI — one unified API for every source',
  description = 'StudioAPI unifies sources across public data, OTA, marketplaces, and more behind one consistent, agent-ready API. One key, one contract, one bill — built for teams and AI agents.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://studioapi.dev" />
    <meta property="og:site_name" content="StudioAPI" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://studioapi.dev/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      // Intro plays once per session; returning within a session skips it.
      (() => {
        try {
          if (sessionStorage.getItem('sa-intro')) {
            document.documentElement.classList.add('intro-done');
          } else {
            sessionStorage.setItem('sa-intro', '1');
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <div class="page-grid" aria-hidden="true"></div>
    <div class="page-grain" aria-hidden="true"></div>
    <div class="content">
      <slot />
    </div>
  </body>
</html>
