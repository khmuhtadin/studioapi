---
import '../styles/global.css';
import { nav, prevNext } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
  slug: string;
}

const { title, description, slug } = Astro.props;
const { prev, next } = prevNext(slug);
const pageDescription = description ?? 'StudioAPI documentation — one unified, agent-ready API for 30+ Indonesian data sources.';
const canonical = `https://docs.studioapi.dev/${slug}/`;
---

<!doctype html>
<html lang="en" class="h-full bg-paper text-ink antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={`${title} — StudioAPI Docs`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} — StudioAPI Docs</title>
  </head>
  <body class="min-h-full">
    <header class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href="https://studioapi.dev" class="inline-flex items-center gap-2.5" aria-label="StudioAPI home">
          <img src="/favicon.svg" alt="" width="22" height="22" />
          <span class="font-mono text-sm font-semibold uppercase tracking-[0.14em]">StudioAPI</span>
          <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-accent">Docs</span>
        </a>
        <nav class="hidden items-center gap-5 md:flex" aria-label="Primary">
          <a href="https://studioapi.dev" class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted hover:text-ink">Home</a>
          <a href="https://studioapi-app.pages.dev" class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted hover:text-ink">Dashboard</a>
          <a href="https://status.studioapi.dev" class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted hover:text-ink">Status</a>
        </nav>
        <a href="https://studioapi-app.pages.dev/register" class="rounded-full bg-accent px-4 py-2 font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-paper hover:brightness-105">Get a key</a>
      </div>
    </header>

    <div class="mx-auto grid max-w-7xl lg:grid-cols-[240px_minmax(0,1fr)]">
      <aside class="hidden border-r border-line lg:block">
        <nav class="sticky top-16 max-h-[calc(100svh-4rem)] overflow-y-auto px-4 py-8" aria-label="Documentation">
          {
            nav.map((group) => (
              <div class="mb-6">
                <p class="mb-2 px-2 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-faint">{group.label}</p>
                <ul class="flex flex-col gap-0.5">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={`/${item.slug}`}
                        class:list={[
                          'block rounded-md px-2 py-1.5 text-sm transition-colors',
                          item.slug === slug
                            ? 'bg-accent/10 font-semibold text-accent'
                            : 'text-muted hover:bg-line/40 hover:text-ink',
                        ]}
                      >{item.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="min-w-0 px-4 py-10 sm:px-8 lg:px-12">
        <div class="mx-auto max-w-3xl">
          <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              <button type="button" class="doc-btn" data-copy-llm data-slug={slug}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy for LLM
              </button>
              <a class="doc-btn" href={`/md/${slug}`} rel="nofollow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
                View as Markdown
              </a>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint">{slug}</span>
          </div>

          <article class="docs-content">
            <slot />
          </article>

          <div class="mt-12 grid gap-3 border-t border-line pt-8 sm:grid-cols-2">
            {
              prev ? (
                <a href={`/${prev.slug}`} class="group rounded-xl border border-line bg-panel p-4 transition-colors hover:border-accent/50">
                  <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint">Previous</span>
                  <p class="mt-1 text-sm font-semibold text-ink group-hover:text-accent">{prev.label}</p>
                </a>
              ) : <span />
            }
            {
              next ? (
                <a href={`/${next.slug}`} class="group rounded-xl border border-line bg-panel p-4 text-right transition-colors hover:border-accent/50">
                  <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint">Next</span>
                  <p class="mt-1 text-sm font-semibold text-ink group-hover:text-accent">{next.label}</p>
                </a>
              ) : <span />
            }
          </div>
        </div>
      </main>
    </div>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-8 font-mono text-[11px] uppercase tracking-[0.14em] text-faint sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <span>© {new Date().getFullYear()} Studio API</span>
        <span>one unified, agent-ready API</span>
      </div>
    </footer>

    <script>
      document.querySelectorAll('[data-copy-llm]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = (btn as HTMLElement).dataset.slug || 'overview';
          const label = btn.textContent;
          try {
            const res = await fetch(`/md/${slug}`);
            if (!res.ok) throw new Error('fetch failed');
            const md = await res.text();
            await navigator.clipboard.writeText(md);
            btn.textContent = 'Copied ✓';
            btn.classList.add('copied');
            setTimeout(() => { btn.textContent = label; btn.classList.remove('copied'); }, 1600);
          } catch {
            btn.textContent = 'Copy failed';
            setTimeout(() => { btn.textContent = label; }, 1600);
          }
        });
      });
    </script>
  </body>
</html>
